generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  MENTOR
  ADMIN
}

enum RequestStatus {
  DRAFT
  PENDING_REVIEW    // submitted / new AI analysis ready — admin must act
  APPROVED          // admin sent approved questions — awaiting member answers
  ASSIGNED          // legacy mentor flow (feature flag off)
  CLOSED_EXPIRED    // legacy 72h auto-close (feature flag off)
  CLOSED_COMPLETED  // final brief approved + admin closed
  CLOSED_INCOMPLETE // admin closed manually
  REJECTED          // admin rejected
}

enum AssignmentStatus {
  ACTIVE
  EXPIRED
  REPLACED
}

enum MessageType {
  TEXT
  VOICE
}

enum MessageSender {
  MEMBER
  MENTOR
}

enum MessageStatus {
  SENT
  DELIVERED
  FAILED
}

enum DraftStatus {
  PENDING_REVIEW
  APPROVED
  EDITED
  REJECTED
}

enum ContributionStatus {
  PENDING    // awaiting payment
  SUBMITTED  // member uploaded receipt
  CONFIRMED  // admin confirmed
  EXEMPT     // admin waived
}

enum SessionStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum FeedbackStatus {
  PENDING
  SUBMITTED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum ServiceVerification {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id             String   @id @default(uuid())
  phone          String   @unique
  email          String?  @unique // admin (reviewer) login
  firstName      String
  lastName       String
  role           Role     @default(MEMBER)
  passwordHash   String
  phoneVerified  VerificationStatus @default(UNVERIFIED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile        Profile?
  mentorProfile  MentorProfile?
  requests       Request[]
  assignments    Assignment[]  @relation("MentorAssignments")
  availability   MentorAvailability[] @relation("MentorAvailability")
  messages       Message[]
  feedback       Feedback[]
  auditLogs      AuditLog[]    @relation("AuditActor")
  otpCodes       OtpCode[]
  loginLinks     LoginLink[]
  consents       ConsentRecord[]

  @@index([role])
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [phone], references: [phone])

  @@index([phone, used])
}

model LoginLink {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique // sha256 of the raw token — raw token is never stored
  expiresAt DateTime // 30 days
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  serviceGroup    String?  // گروه خدمتگزاری
  activityDesc    String?  // شرح کوتاه فعالیت
  verification    ServiceVerification @default(PENDING)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MentorProfile {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @unique
  expertise       String[] // حوزه‌های تخصصی
  capacity        Int      @default(5)  // max active cases
  activeCount     Int      @default(0)
  trainingWatched Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Request {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  title           String?
  description     String   // confirmed transcript / typed text — the only text in the case
  status          RequestStatus @default(PENDING_REVIEW)
  domain          String   @default("legal") // حقوقی - expandable
  contributionAmount Int?  // amount accepted at time of submission
  consentVersion  String?
  consentAcceptedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  closedAt        DateTime?

  assignment      Assignment?
  messages        Message[]
  attachments     Attachment[]
  aiDrafts        AIDraft[]
  claritySections ClaritySection[]
  aiRounds        AiRound[]
  proposedQuestions ProposedQuestion[]
  sessions        Session[]
  finalBrief      FinalBrief?
  contribution    Contribution?
  consentRecords  ConsentRecord[]
  feedback        Feedback[]

  @@index([status])
  @@index([userId])
}

model Assignment {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String   @unique
  mentor      User     @relation("MentorAssignments", fields: [mentorId], references: [id])
  mentorId    String
  status      AssignmentStatus @default(ACTIVE)
  startedAt   DateTime @default(now())
  targetAt    DateTime?         // clarify target (default 24h, configurable) — deadline for completing clarification
  expiresAt   DateTime          // hard expiry (default 72h, configurable)
  completedAt DateTime?
  delayHours  Int?              // hours past targetAt when case closed (0 = on time)
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mentorId, status])
}

model MentorAvailability {
  id          String @id @default(uuid())
  mentor      User   @relation("MentorAvailability", fields: [mentorId], references: [id], onDelete: Cascade)
  mentorId    String
  dayOfWeek   Int    // 0 = Saturday … 6 = Friday (Persian week)
  startMinute Int    // minutes from midnight
  endMinute   Int    // endMinute - startMinute must be >= 15
  createdAt   DateTime @default(now())

  @@index([mentorId])
}

model Message {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  sender      MessageSender
  userId      String?  // who sent it (member or admin user id)
  type        MessageType @default(TEXT)
  content     String?  // text content or confirmed transcript of voice
  attachmentId String? // for voice messages
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  status      MessageStatus @default(SENT)
  createdAt   DateTime @default(now())

  @@index([requestId, createdAt])
}

model Attachment {
  id          String   @id @default(uuid())
  request     Request?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String?
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String?  // legacy disk path (payments flag) — unused in v4
  data        Bytes?   // audio stored in the database (survives restarts / free-tier disks)
  uploadedBy  String
  createdAt   DateTime @default(now())

  messages    Message[]
}

model AIDraft {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  content     String   // draft question/summary
  status      DraftStatus @default(PENDING_REVIEW)
  reviewedBy  String?  // mentor user id
  reviewedAt  DateTime?
  contentHash String?  // hash at review time to prevent approving stale version
  sentMessageId String? // message id if approved and sent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestId, status])
}

model ClaritySection {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  axisNumber  Int      // 1-15 (the 15 clarity dimensions)
  axisLabel   String
  enabled     Boolean  @default(false) // mentor marks relevant axes
  confirmed   Boolean  @default(false) // mentor confirms status
  notes       String?
  updatedAt   DateTime @updatedAt

  @@unique([requestId, axisNumber])
}

model ProgressSection {
  id          String   @id @default(uuid())
  requestId   String
  section     Int      // 1-5 (the 5 progress parts)
  label       String
  confirmed   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([requestId, section])
}

model AiRound {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  round       Int      // 1-based per kind
  kind        String   @default("ANALYSIS") // ANALYSIS | FINAL_SHEET
  inputText   String   // thread text sent to the model
  status      String   @default("PENDING") // PENDING (در حال تحلیل) | DONE | FAILED
  output      Json?    // validated structured output — never exposed to member
  error       String?
  tokensIn    Int?
  tokensOut   Int?
  costUsd     Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestId, kind])
  @@index([status])
}

model ProposedQuestion {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  roundId     String?  // AiRound that proposed it (null = manual)
  text        String
  source      String   @default("AI") // AI | MANUAL
  status      String   @default("PENDING") // PENDING | APPROVED | EDITED | DELETED | SENT
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestId, status])
}

model Session {
  id          String   @id @default(uuid())
  request     Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String
  status      SessionStatus @default(REQUESTED)
  requestedAt DateTime @default(now())
  scheduledAt DateTime?
  link        String?
  memberAttended Boolean?
  mentorAttended Boolean?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinalBrief {
  id              String   @id @default(uuid())
  request         Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       String   @unique
  title           String
  initialDesc     String
  clarifiedProblem String
  desiredOutcome  String
  priority        String?
  constraints     String?
  prerequisites   String?
  incompleteInfo  String?
  criteria        String?
  nextStep        String?  // قدم بعدی
  openTopics      String?
  mentorName      String?
  summaryAt       DateTime?
  mentorApproved  Boolean  @default(false)
  memberApproved  Boolean?
  memberFeedback  String?
  aiDraftContent  String?  // AI-generated draft
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ConsentRecord {
  id              String   @id @default(uuid())
  request         Request?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String?   // first-login consent (before any request exists)
  version         String
  text            String   // full consent text at time of acceptance
  acceptedAt      DateTime @default(now())

  @@index([userId])
}

model Contribution {
  id              String   @id @default(uuid())
  request         Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       String   @unique
  amount          Int      // in toman
  status          ContributionStatus @default(PENDING)
  receiptPath     String?  // uploaded receipt file
  confirmedBy     String?  // admin user id
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Feedback {
  id              String   @id @default(uuid())
  request         Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId       String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  rating          Int      // 1-5
  comment         String?
  status          FeedbackStatus @default(PENDING)
  createdAt       DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorId     String?
  action       String   // e.g. "ROLE_CHANGE", "CREATE_MEMBER", "APPROVE_QUESTION"
  entityType   String
  entityId     String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
}

model Setting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String
  updatedAt        DateTime @updatedAt
}
